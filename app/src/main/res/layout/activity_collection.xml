<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCollection"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorSurface"
        android:elevation="4dp"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:navigationContentDescription="@string/cd_navigate_back"
        app:navigationIconTint="@color/colorTextPrimary"
        app:titleTextColor="@color/colorTextPrimary" />

    <TextView
        android:id="@+id/tvCollectionHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_m"
        android:paddingVertical="@dimen/spacing_s"
        android:text="@string/collection_hint_long_press"
        android:textColor="@color/colorTextMuted"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCollectionItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/grid_gap"
            android:paddingTop="@dimen/grid_gap" />

        <TextView
            android:id="@+id/tvCollectionEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="@dimen/spacing_l"
            android:text="@string/collection_empty"
            android:textColor="@color/colorTextMuted"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCollectionAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_m"
        android:backgroundTint="@color/colorAccent"
        android:minHeight="@dimen/touch_target_min"
        android:text="@string/collection_add_listings"
        android:textColor="@color/white" />
</LinearLayout>
