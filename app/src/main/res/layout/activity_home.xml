<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/homeToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        android:background="@color/colorSurface"
        android:elevation="4dp"
        app:contentInsetStart="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="@string/app_name"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btnNotificationsTopBar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_notifications">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_tab_notifications"
                        app:tint="@color/colorTextPrimary" />

                    <TextView
                        android:id="@+id/tvNotificationsUnreadBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_unread_badge"
                        android:gravity="center"
                        android:minWidth="16dp"
                        android:minHeight="16dp"
                        android:paddingStart="3dp"
                        android:paddingEnd="3dp"
                        android:text="1"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnScanQrTopBar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_scan_qr_code">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_tab_scan"
                        app:tint="@color/colorTextPrimary" />

                    <!-- No badge needed for QR scan -->
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnMessagesTopBar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_messages">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_tab_messages"
                        app:tint="@color/colorTextPrimary" />

                    <TextView
                        android:id="@+id/tvMessagesUnreadBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_unread_badge"
                        android:gravity="center"
                        android:minWidth="16dp"
                        android:minHeight="16dp"
                        android:paddingStart="3dp"
                        android:paddingEnd="3dp"
                        android:text="1"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/homeToolbar"
        android:layout_above="@+id/bottomNav" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:background="@color/colorSurface"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/nav_home"
            style="@style/CampusConnectBottomNavItem"
            android:contentDescription="Home">
            <ImageView android:id="@+id/ivNavHome" style="@style/CampusConnectBottomNavIcon" android:src="@drawable/ic_tab_home" />
            <TextView android:id="@+id/tvNavHome" style="@style/CampusConnectBottomNavLabel" android:text="Home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_search"
            style="@style/CampusConnectBottomNavItem"
            android:contentDescription="Search">
            <ImageView android:id="@+id/ivNavSearch" style="@style/CampusConnectBottomNavIcon" android:src="@drawable/ic_tab_search" />
            <TextView android:id="@+id/tvNavSearch" style="@style/CampusConnectBottomNavLabel" android:text="Search" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_create"
            style="@style/CampusConnectBottomNavItem"
            android:contentDescription="Create">
            <ImageView
                android:id="@+id/ivNavCreate"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_nav_post"
                android:padding="6dp"
                android:src="@drawable/ic_tab_camera" />
            <TextView android:id="@+id/tvNavCreate" style="@style/CampusConnectBottomNavLabel" android:text="Create" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_listings"
            style="@style/CampusConnectBottomNavItem"
            android:contentDescription="Listings">
            <ImageView android:id="@+id/ivNavListings" style="@style/CampusConnectBottomNavIcon" android:src="@drawable/ic_tab_listings" />
            <TextView android:id="@+id/tvNavListings" style="@style/CampusConnectBottomNavLabel" android:text="Listings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_profile"
            style="@style/CampusConnectBottomNavItem"
            android:contentDescription="Profile">
            <ImageView android:id="@+id/ivNavProfile" style="@style/CampusConnectBottomNavIcon" android:src="@drawable/ic_tab_profile" />
            <TextView android:id="@+id/tvNavProfile" style="@style/CampusConnectBottomNavLabel" android:text="Profile" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>