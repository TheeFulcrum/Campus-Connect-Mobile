<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme matching the website colors -->
    <style name="Base.Theme.CampusConnectMobile" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryDark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/colorAccentDark</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <item name="colorTertiary">@color/colorSuccess</item>
        <item name="colorOnTertiary">@color/white</item>

        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/white</item>

        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorOnBackground">@color/colorTextPrimary</item>

        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorTextPrimary</item>
        <item name="colorSurfaceVariant">@color/colorBorder</item>
        <item name="colorOnSurfaceVariant">@color/colorTextMuted</item>
    </style>
    <style name="Theme.CampusConnectMobile" parent="Base.Theme.CampusConnectMobile" />

    <style name="CampusConnectBottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="CampusConnectBottomNavIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:tint">@color/colorTextMuted</item>
    </style>

    <style name="CampusConnectBottomNavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/colorTextMuted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <!-- SplashScreen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/colorSurface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.CampusConnectMobile</item>
    </style>
</resources>