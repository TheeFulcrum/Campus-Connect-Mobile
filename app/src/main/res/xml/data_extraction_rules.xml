<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include SharedPreferences -->
        <include domain="sharedpref" />

        <!-- Include SQLite databases -->
        <include domain="database" />

        <!-- Include files in getFilesDir() -->
        <include domain="file" />

        <!-- Exclude caches and no-backup files -->
        <exclude domain="file" path="cache/**" />
        <exclude domain="file" path="no_backup/**" />
    </cloud-backup>
</data-extraction-rules>